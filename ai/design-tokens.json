{
  "$comment": "Platform-neutral design tokens for Nani Bachat. Source of truth in code: mobile/src/theme/colors.js. Keep both in sync.",
  "font": { "family": "Inter", "weights": [400, 500, 600, 700], "note": "Numbers: use tabular figures only if a screen needs aligned columns. Nothing else uses another family." },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32, "huge": 48, "grid": 4, "nudge": 2 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 18, "xxl": 22, "full": 9999, "card": 18, "control": 10, "avatarLogo": 8 },
  "typography": {
    "screenTitle": { "size": 24, "weight": 700 },
    "sectionTitle": { "size": 18, "weight": 700 },
    "cardTitle": { "size": 16, "weight": 600, "use": "card titles and names" },
    "body": { "size": 14, "weight": 500 },
    "secondary": { "size": 13, "weight": 400 },
    "caption": { "size": 12, "weight": 400 },
    "infoTitle": { "size": 9, "weight": 400, "use": "column / info titles above a list" },
    "button": { "size": 14, "weight": 600 },
    "input": { "size": 14, "weight": 500 },
    "portfolioValue": { "size": 28, "weight": 700 },
    "listRow": { "title": 14, "value": 12, "grey": 10 },
    "summaryRow": { "label": 12, "value": 12 },
    "tabLabel": { "size": 10, "weight": 600 }
  },
  "color": {
    "dark": {
      "background": "#111213", "card": "#18191B", "surface": "#1F2023", "surfaceLight": "#2A2B2F",
      "accent": "#879DFF", "onAccent": "#FFFFFF",
      "buttonPrimary": "#465FE2", "buttonPrimaryPressed": "#3954D0", "buttonDanger": "#BD2737",
      "textPrimary": "#F3F2EF", "textSecondary": "#A5A39D", "textMuted": "#9A9690",
      "profit": "#22C55E", "profitBg": "#12351F", "loss": "#F87171", "lossBg": "#3A171B",
      "warning": "#F59E0B", "warningBg": "#3A2A0D", "neutral": "#A5A39D",
      "border": "#2A2B2F", "inputBorder": "#777670", "placeholder": "#9A9690", "divider": "rgba(255,255,255,0.06)",
      "chartCategories": ["#4D6BFF", "#6E87FF", "#9BACFF", "#8A8780", "#A5A39D", "#C4C1B9"]
    },
    "light": {
      "background": "#F6F5F2", "card": "#FFFFFF", "surface": "#F1F0EC", "surfaceLight": "#E7E5DF",
      "accent": "#1E41DB", "onAccent": "#FFFFFF",
      "buttonPrimary": "#1E41DB", "buttonPrimaryPressed": "#1835B8", "buttonDanger": "#B91C1C",
      "textPrimary": "#161615", "textSecondary": "#5C5A55", "textMuted": "#64615B",
      "profit": "#137535", "profitBg": "#DCFCE7", "loss": "#B91C1C", "lossBg": "#FEE2E2",
      "warning": "#92400E", "warningBg": "#FEF3C7", "neutral": "#64615B",
      "border": "#E7E5DF", "inputBorder": "#85827A", "placeholder": "#64615B", "divider": "rgba(0,0,0,0.07)",
      "chartCategories": ["#2845AD", "#4964CF", "#667CDD", "#58564F", "#6F6C63", "#858278"]
    },
    "avatarBackground": "#FFF7DA"
  },
  "sizes": {
    "logo": 40, "logoDetail": 56, "avatarList": 44, "avatarHeader": 36, "avatarProfile": 64, "avatarPicker": 48,
    "tabBarHeight": 64, "tabBarPadding": 5, "roundButton": 40, "iconDefault": 18, "chartHeight": 120, "donut": 180, "donutThickness": 26
  },
  "motion": { "pressScale": 0.97, "pressOpacity": 0.85, "screenTransition": "slide from right, slide out on back", "toast": "spring in from top" }
}
