{
  "expo": {
    "name": "Nani Bachat",
    "slug": "nani-bachat",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nanibachat",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nanibachat.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FCF8F3"
      },
      "package": "com.nanibachat.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "backgroundColor": "#F6F5F2",
          "dark": {
            "image": "./assets/adaptive-icon.png",
            "backgroundColor": "#111213"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00D09C",
          "androidMode": "default",
          "androidCollapsedTitle": "Nani Bachat"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b2bd3407-0cde-4e98-842d-4f9161bfda0b"
      }
    },
    "owner": "alekh5806"
  }
}
